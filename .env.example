# Site Reliability Assessment Bot - settings with the defaults used in code.
# Copy to .env (gitignored) and change what you need. Real environment variables override .env;
# in the cluster these come from the Helm chart instead. Relative paths are relative to the repo root.

# Local LLM
# false = no generative model at all: runs are rules and checklists only, criterion chat is off, and criteria
# without a rule are left for the assessor. Embedding-based incident clustering is not affected.
LLM_ENABLED=true
# Provider: ollama | openai_compat (vLLM, llama.cpp server; then use http://localhost:8000/v1)
LLM_PROVIDER=ollama
# One server, or several comma-separated (e.g. one per Ollama replica); criteria are spread across them
LLM_BASE_URL=http://localhost:11434
# Calls in flight per server. Empty = use OLLAMA_NUM_PARALLEL if it is set in the environment this app runs in
# (e.g. a Windows user variable that the local Ollama also reads), else 1. Set it explicitly when the app and the
# server don't share an environment, several workers share one server, or for a vLLM server. On one CPU machine
# expect a small gain at most (parallel calls share the cores); more servers or a GPU is where it pays off.
LLM_CONCURRENCY=
# Laptop default; cluster candidate is qwen3.5:4b
LLM_MODEL=qwen3.5:4b
# true re-enables reasoning mode (slow on CPU)
LLM_THINK=false
# Seconds per call
LLM_TIMEOUT=300
# Ollama context window
LLM_NUM_CTX=8192
# Most tokens a reply may have (the JSON schema also caps field lengths)
LLM_NUM_PREDICT=768
# How long Ollama keeps the model in memory after a call (-1 = until the server stops)
LLM_KEEP_ALIVE=30m
# CPU threads for Ollama; empty = Ollama decides. Set to the number of physical cores.
LLM_NUM_THREAD=
# Evidence passages per criterion, and the most characters kept from each
LLM_TOP_K=4
LLM_CHUNK_CHARS=800
# Reuse the previous answer when the model, prompt and evidence are unchanged (false = always ask the model)
LLM_CACHE=true
# Only for an openai_compat server that requires a key
LLM_API_KEY=not-needed

# Claude through the Anthropic Messages API: on CAP, the CVS LMS gateway OIP uses (the Helm chart's default provider).
# Used when LLM_PROVIDER=anthropic. Evidence is then sent to the hosted model. Also set LLM_MODEL (through the gateway
# OIP confirmed claude-opus-5). The key is supplied at runtime from the approved secret store.
# ANTHROPIC_BASE_URL=https://hyperion-lms-api.prod.cvshealth.com
# ANTHROPIC_API_KEY=
# How the structured answer is asked for: auto (native for api.anthropic.com, tool for any other address) | native
# (output_config.format; the gateway rejects it) | tool (forced submit_answer call + one corrective retry, as OIP) | prompt
LLM_OUTPUT_MODE=auto
# low | medium | high | xhigh | max; empty = not sent. Unset: medium in native mode, not sent otherwise
# LLM_EFFORT=
# Older switch: false = prompt mode (the schema described in the prompt)
LLM_STRUCTURED_OUTPUT=true
LLM_MAX_TOKENS=16000
# default = on a safety decline let the API retry on a fallback model. Not available through Amazon Bedrock: leave empty
LLM_REFUSAL_FALLBACK=

# Storage
# Empty = local files under SRA_DATA_DIR. Set to use PostgreSQL (pgvector), e.g. the docker-compose database:
# DATABASE_URL=postgresql://sra:sra-dev-only@localhost:5432/sra
DATABASE_URL=
# On CAP the database settings are injected instead (as for COG) and used when DATABASE_URL is empty:
#   CAP_POSTGRES_<APP>_<DB>_JDBC_URI, CAP_POSTGRES_USER (IAM login through the cloud-sql-proxy sidecar)
# All tables are prefixed sra_, so the database can be shared with COG (cog_ tables)
# If CAP injects more than one database, name the variable to use:
SRA_CAP_POSTGRES_VAR=
# Hybrid retrieval: keyword + vector search fused with RRF runs in Postgres when there is a database (in memory otherwise)
# off | auto: re-order the best results with the local cross-encoder when its files are in the cache
RETRIEVAL_RERANK=off

# ServiceNow connector for the standing knowledge store (needs PostgreSQL). Empty URL = connector off.
# Tables, field names and query scope: config/sources.yaml. Run it with `sra ingest --servicenow`, the worker, or
# POST /api/knowledge/sync. Credentials come from the approved secret store at runtime: never commit them.
SERVICENOW_INSTANCE_URL=
# one of: an OAuth bearer token, or a user and password
# SERVICENOW_TOKEN=
# SERVICENOW_USER=
# SERVICENOW_PASSWORD=

# GitHub repository scan through the GitHub CLI (gh). The token is gh's: never put it in code or in this file.
# Production (CAP, a shared server): GH_TOKEN (github.com) or GH_ENTERPRISE_TOKEN (any other host) comes from the
# secret store; gh reads it and the app never does. A sign-in stored in the container's gh config would act for every
# user and is lost on restart, so the interactive sign-in stays off there.
# GH_TOKEN=
# GH_ENTERPRISE_TOKEN=
# GitHub Enterprise host; empty = github.com
GH_HOST=
# Hosts assessors may scan (comma-separated); empty = GH_HOST
SRA_GITHUB_HOSTS=
# Path to gh; empty = gh on PATH (the Docker image sets /app/bin/gh)
SRA_GH=
# How a commit's files are read: auto (one archive for small repositories, otherwise file by file) | archive | files
SRA_GITHUB_FETCH=auto
SRA_GITHUB_MAX_ARCHIVE_MB=300
# file-by-file reading: parallel downloads (GitHub discourages more than ~10)
SRA_GITHUB_FETCH_WORKERS=8
# Local and dev only: let the web UI sign gh in with the device flow (one-time code, no password) and sign out.
# Ignored for a host that has an environment token. (`sra github login` on a terminal runs gh directly and needs no flag.)
SRA_GH_INTERACTIVE_LOGIN=false
# With the above: also accept a pasted token (handed to `gh auth login --with-token`, kept only in gh's store)
SRA_GH_TOKEN_LOGIN=false
DB_POOL_MAX=5
# Where uploaded evidence files go. Empty = in the database (sra_blobs) when there is one, as OIP keeps everything in
# Postgres; data/blobs on disk otherwise. Set a bucket name to keep them in GCS instead.
SRA_GCS_BUCKET=
SRA_DATA_DIR=data

# In-process scheduler (`sra serve`, as OIP runs its jobs): knowledge-store ingestion at these hours (container clock,
# e.g. 2 or 2,14; empty = none), once at start, and whether it refreshes the OIPReqs library. Needs PostgreSQL.
SRA_INGEST_HOURS=
SRA_RUN_ON_START=false
SRA_INGEST_STANDARDS=true

# Kafka (optional; off as on CAP)
# Empty = jobs run in-process. Set (e.g. localhost:9092) to send jobs to Kafka; then run `sra worker`,
# which also needs DATABASE_URL.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_GROUP=sra-worker
# Only for secured Kafka, e.g. SASL_SSL with PLAIN
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Server and paths
PORT=8080
SRA_MAX_UPLOAD_MB=50
# Keep SRE decisions on criteria (training data) when an assessment is deleted, with the evidence passages they
# were based on. false = delete them with the assessment.
SRA_KEEP_FEEDBACK=true
# Checklist line suggestions from the NLI model, when its files are in the local Hugging Face cache
# (never downloaded by the app). off = never.
SRA_SUGGEST=auto
# Text in images (uploads, pictures inside DOCX/PDF, scanned PDFs) with the local RapidOCR model. false = images
# are only noted. Per document: at most this many images and seconds of OCR (a dense diagram takes ~30 s on CPU).
SRA_OCR=true
SRA_OCR_MAX_IMAGES=20
SRA_OCR_MAX_SECONDS=60
SRA_WEB_DIST=web/dist
SRA_DOCS_DIR=docs/OIPReqs
SRA_CATALOG_DIR=catalog
SRA_CONFIG_DIR=config
# SRA_ROOT is read from the real environment only (not .env); the Docker image sets it to /app.

# Scenario generator ONLY (eval/synthetic/generate_scenarios.py); the app itself never uses these.
# OpenAI-compatible Microsoft Foundry endpoint, e.g. https://<resource>.services.ai.azure.com/openai/v1/
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
APP_MODEL=
# low | medium | high (reasoning effort)
APP_EFFORT=low
